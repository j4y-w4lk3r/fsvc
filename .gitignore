 # Python bytecode and build artifacts
 __pycache__/
 *.py[cod]
 *.pyo
 *.pyd
 *.so
 *.egg-info/
 .eggs/
 build/
 dist/
 *.log

 # Virtual environments
 .venv/
 venv/
 env/
 ENV/

 # OS / editor cruft
 .DS_Store
 .idea/
 .vscode/

 # Environment files
 .env
 .env.*
 *.env
 *.env.*

 # Revolut / banking secrets (keep out of git)
 rev/revolut.env
 rev/revolut-api-cert/
 rev/*.pem
 rev/*.key
 rev/*.p12
 rev/*.pfx

 # Generic key / cert material (treated as secrets by default)
 *.pem
 *.key
 *.p12
 *.pfx
 *.crt
 *.cer
 *.der

