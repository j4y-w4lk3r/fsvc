# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
build/
dist/
*.log

# Virtual environments
.venv/
venv/
env/
ENV/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# Environment files
.env
.env.*
*.env
*.env.*

# Revolut / banking secrets (keep out of git in plaintext)
/rev/revolut.env
# Do not track plaintext key/cert material under rev/, but allow encrypted .enc files
/rev/*.pem
/rev/*.key
/rev/*.p12
/rev/*.pfx
/rev/*.crt
/rev/*.cer
/rev/*.der
/rev/revolut-api-cert/*.pem
/rev/revolut-api-cert/*.key
/rev/revolut-api-cert/*.p12
/rev/revolut-api-cert/*.pfx
/rev/revolut-api-cert/*.crt
/rev/revolut-api-cert/*.cer
/rev/revolut-api-cert/*.der

# Generic key / cert material (treated as secrets by default, plaintext not tracked)
/*.pem
*.pem
/*.key
*.key
/*.p12
*.p12
/*.pfx
*.pfx
/*.crt
*.crt
/*.cer
*.cer
/*.der
*.der

# Allow committing encrypted variants
!*.sops.*
!*.enc

