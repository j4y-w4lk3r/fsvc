# Local config — never committed. config.example.toml ships in the repo.
config.toml
*.config.toml

# Decrypted secrets — staged at runtime via `ykw decrypt`, never tracked.
# fsvc loads encrypted *.gpg blobs and materializes plaintext counterparts
# inside $XDG_CONFIG_HOME/fsvc/ at runtime. The plaintext SHOULD live there
# (never in this repo), but defense-in-depth: if anyone ever copies the
# materialized files into the repo by accident, git refuses them.
revolut.env
revolut_private.key
revolut_public.crt
privatecert.pem
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx

# Allow the encrypted variants if someone ever wants to commit one for
# offsite-mirror reasons (the bu repo does this for the bundle).
!*.gpg
!*.enc

# Binary artefact at repo root: `go build` drops it here. Anchored to root
# so it doesn't accidentally match cmd/fsvc/.
/fsvc
*.exe

# goreleaser snapshot/release output. Re-created on every build.
/dist/

# Python-legacy detritus (the legacy Python codebase carries its own venv
# discipline; we just pre-emptively gitignore the usual suspects).
python-legacy/.venv/
__pycache__/
*.pyc
*.pyo

# OS / editor cruft
.DS_Store
.idea/
.vscode/
