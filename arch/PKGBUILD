# Maintainer: j4y <j4y_w4lk3r@pobox.com>
#
# fsvc-bin — Financial-services CLI for the j4y suite.
# Revolut Business today (mTLS + JWT + OAuth client-assertion in one
# binary), ING tomorrow.
#
# Binary package: pulls the prebuilt linux-x86_64 tarball that goreleaser
# attaches to every GitHub release. No Go toolchain needed at install
# time. A future `fsvc` (source) package can build from source for
# arm64-on-Arch or non-glibc users; until then this covers ~99% of
# Arch users.
#
# Release flow:
#   1. `git tag vX.Y.Z && git push origin vX.Y.Z`
#   2. .github/workflows/release.yml runs goreleaser, which uploads
#      fsvc_X.Y.Z_Linux_x86_64.tar.gz to the release AND auto-pushes the
#      AUR bump (via the goreleaser `aurs:` block + AUR_SSH_PRIVATE_KEY).
#   3. arch/aur-bump.sh exists as a manual fallback in case the goreleaser
#      AUR push ever needs a re-run.

pkgname=fsvc-bin
_pkgname=fsvc
pkgver=0.1.0
pkgrel=1
pkgdesc="Financial-services CLI: Revolut Business today, ING tomorrow"
arch=('x86_64')
url="https://github.com/j4y-w4lk3r/fsvc"
license=('MIT')
depends=('glibc')
optdepends=(
    'gnupg: fsvc bootstrap shells out to ykw which shells out to gpg'
    'ykw: fsvc bootstrap shells out to ykw decrypt for the encrypted creds'
    'bbm: fsvc bootstrap shells out to bbm pull to fetch encrypted creds from B2'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}" "${_pkgname}-git")

# Replaced per release by `arch/aur-bump.sh`.
source=("${_pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}_${pkgver}_Linux_x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}"

    install -Dm755 "${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

    install -Dm644 LICENSE             "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md           "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    install -Dm644 config.example.toml "${pkgdir}/usr/share/doc/${pkgname}/config.example.toml"
}
